#!/usr/bin/env bash
#
# Install this package's ssh-agent as a user LaunchAgent: writes
# ~/Library/LaunchAgents/org.forkcloser.ssh_agent.plist pointing at the
# launch script, bootstraps it, and makes every shell rc it knows source
# ~/.ssh/org.forkcloser.agent.env, which the launch script writes at every
# start. Apple's agent is left alone: it listens on its own socket and
# nothing reaches it once SSH_AUTH_SOCK is ours.
#
# The plist names the launch script by this package's own path: launchd
# starts it with HOME and the system PATH only, where a tool manager's proxy
# has nothing to resolve itself with. After an upgrade to another package
# directory, run this again.
#
#   ssh-agent-install            install and start
#   ssh-agent-install uninstall  stop and remove

set -euo pipefail

label='org.forkcloser.ssh_agent'
plist="${HOME}/Library/LaunchAgents/${label}.plist"
logs="${HOME}/Library/Logs/org.forkcloser.ssh_agent"
domain="gui/$(id -u)"
# The line as it goes into each rc, unexpanded: the rc keeps tracking $HOME.
# Guarded, so a shell started before the agent's first run, or after an
# uninstall that left the rc, does not complain at every prompt. The env
# file names the socket; this line never does, so a rename is invisible here.
env_file="${HOME}/.ssh/org.forkcloser.agent.env"
# shellcheck disable=SC2016 # the line is for the shell that reads it
rc_line='[ -r "$HOME/.ssh/org.forkcloser.agent.env" ] && . "$HOME/.ssh/org.forkcloser.agent.env"'
rc_mark='# forkcloser/openssh: the agent the LaunchAgent runs'
# What earlier installs wrote: a fixed export, replaced wherever it is found.
# shellcheck disable=SC2016 # the line is for the shell that reads it
old_line='export SSH_AUTH_SOCK="$HOME/.ssh/org.forkcloser.agent.sock"'
# Every rc a shell of this account may read, not the login shell's alone:
# the one picked by $SHELL left the others without the variable.
rcs=("${HOME}/.zshrc" "${HOME}/.bashrc" "${HOME}/.profile")

# strip_lines <rc>: the lines the install writes, and only those, taken
# out; written through, so an rc that is a symlink into a dotfiles tree
# stays one.
strip_lines() {
  grep -vxF -e "${rc_mark}" -e "${rc_line}" -e "${old_line}" "$1" > "$1.tmp" || true
  cat "$1.tmp" > "$1" && rm -f "$1.tmp"
}

if [ "${1:-}" = 'uninstall' ]; then
  launchctl bootout "${domain}/${label}" 2> /dev/null || true
  rm -f "${plist}"
  # The login session's SSH_AUTH_SOCK, set by the launch script for GUI
  # applications: gone with the agent, when it is this agent's socket and
  # not another HOME's. launchd's own value (Apple's socket) is back at the
  # next login.
  if [ "$(launchctl getenv SSH_AUTH_SOCK 2> /dev/null)" = "${HOME}/.ssh/org.forkcloser.agent.sock" ]; then
    launchctl unsetenv SSH_AUTH_SOCK 2> /dev/null || true
  fi
  rm -f "${env_file}"
  cleaned=()
  for rc in "${rcs[@]}"; do
    if [ -f "${rc}" ] && grep -qxF -e "${rc_line}" -e "${old_line}" -- "${rc}"; then
      strip_lines "${rc}"
      cleaned+=("${rc}")
    fi
  done
  if [ "${#cleaned[@]}" -gt 0 ]; then
    echo "removed ${label} and the agent line from ${cleaned[*]}; open a new shell"
  else
    echo "removed ${label}"
  fi
  exit 0
fi

self="$(cd "$(dirname "$(readlink -f "$0")")" && pwd -P)"
script="$(cd "${self}/../libexec" && pwd -P)/ssh-agent-launchd"
[ -x "${script}" ] || { echo "ssh-agent-install: no launch script at ${script}" >&2; exit 1; }

mkdir -p "${HOME}/Library/LaunchAgents" "${logs}"

# Already running under this label: stop it, so the new plist is what starts.
launchctl bootout "${domain}/${label}" 2> /dev/null || true

sed -e "s|{LAUNCH_SCRIPT}|${script}|" -e "s|{LOG_DIR}|${logs}|" \
  "${self}/../share/forkcloser/${label}.plist" > "${plist}"

launchctl bootstrap "${domain}" "${plist}"

# Each rc once: an rc that carries the line is left alone, one that carries
# the fixed export of an earlier install has it replaced.
written=()
for rc in "${rcs[@]}"; do
  if [ -f "${rc}" ] && grep -qxF -- "${rc_line}" "${rc}"; then
    continue
  fi
  if [ -f "${rc}" ] && grep -qxF -- "${old_line}" "${rc}"; then
    strip_lines "${rc}"
  fi
  printf '\n%s\n%s\n' "${rc_mark}" "${rc_line}" >> "${rc}"
  written+=("${rc}")
done
if [ "${#written[@]}" -gt 0 ]; then
  echo "installed ${label} (${script}); the agent line appended to ${written[*]}: open a new shell, or source ${env_file}; GUI applications see the agent once relaunched"
else
  echo "installed ${label} (${script}); every rc already sources ${env_file}; GUI applications see the agent once relaunched"
fi
