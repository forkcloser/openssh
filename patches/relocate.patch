diff --git a/misc.c b/misc.c
index 866f7b8..3005a2c 100644
--- a/misc.c
+++ b/misc.c
@@ -3348,3 +3348,37 @@ mkdir_path(const char *target, mode_t mode)
 	return ret;
 #endif
 }
+
+/*
+ * Relocation: the configuration directory and the helpers live beside the
+ * executable, under the prefix the package was unpacked to, not at a path
+ * fixed when it was built. The prefix is the parent of the directory holding
+ * the executable (bin, sbin or libexec), after resolving symlinks, so a
+ * symlink in a tool manager's bin directory still lands in the package.
+ */
+#include <mach-o/dyld.h>
+
+const char *
+reloc_path(const char *rel)
+{
+	static char prefix[PATH_MAX];
+	char exe[PATH_MAX], real[PATH_MAX], *p;
+	uint32_t size = sizeof(exe);
+
+	if (prefix[0] == '\0') {
+		if (_NSGetExecutablePath(exe, &size) != 0 ||
+		    realpath(exe, real) == NULL)
+			fatal("reloc_path: cannot locate the running executable");
+		/* strip the file name, then the bin/libexec directory */
+		if ((p = strrchr(real, '/')) == NULL)
+			fatal("reloc_path: no directory in %s", real);
+		*p = '\0';
+		if ((p = strrchr(real, '/')) == NULL)
+			fatal("reloc_path: no prefix above %s", real);
+		*p = '\0';
+		if (strlcpy(prefix, real, sizeof(prefix)) >= sizeof(prefix))
+			fatal("reloc_path: prefix too long");
+	}
+	xasprintf(&p, "%s/%s", prefix, rel);
+	return p;
+}
